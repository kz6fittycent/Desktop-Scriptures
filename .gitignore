__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.pytest_cache/

# Local-only download per README - the app never fetches this over the
# network, and it's fully redundant with the already-committed
# data/scriptures.db it gets imported into.
data/raw/lds-scriptures.txt

# Local-only download via scripts/download_tts_voices.py - each voice
# model is ~60MB, too large to commit; snapcraft.yaml's "tts-voices"
# part fetches the same files fresh at build time instead.
data/tts_voices/

# Local snapcraft build output
*.snap

# Overnight/background run logs (e.g. scripts/harvest_liahona_citations.py
# left running unattended via nohup) - just console output, not data.
*.log
